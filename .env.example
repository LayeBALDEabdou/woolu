# Remplacer VOTRE_IP_OU_DOMAINE par l'adresse du VPS
DJANGO_SECRET_KEY=changez-moi-avec-une-longue-chaine-aleatoire
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=VOTRE_IP_OU_DOMAINE,localhost
CORS_ALLOWED_ORIGINS=http://VOTRE_IP_OU_DOMAINE:3004

# PostgreSQL (conteneur sur le réseau docker twoylit_postgres_network)
# POSTGRES_HOST = nom du conteneur postgres sur ce réseau
POSTGRES_DB=woolu
POSTGRES_USER=woolu
POSTGRES_PASSWORD=changez-moi
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Bitnob (https://app.bitnob.com → Paramètres → API / Webhooks)
BITNOB_CLIENT_ID=
BITNOB_CLIENT_SECRET=
BITNOB_WEBHOOK_SECRET=
