# Mode d'exécution du frontend :
#   demo : données et paiements SIMULÉS dans le navigateur (aucun appel réseau, aucun fonds réel)
#   api  : appels au backend Wóolu (Django) défini par NEXT_PUBLIC_API_BASE_URL
NEXT_PUBLIC_APP_MODE=demo

# URL publique de l'API backend (utilisée uniquement en mode api).
# Exemple en développement : http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=

# ⚠ Aucune clé Bitnob ne doit figurer ici : toute variable NEXT_PUBLIC_* est exposée au navigateur.
# Les clés Bitnob (API key, secret de webhook) appartiennent exclusivement au backend.
