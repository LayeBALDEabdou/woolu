# Copier ce fichier en .env pour le développement local : cp .env.example .env

# Django
DJANGO_SECRET_KEY=changez-moi
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Adresse du frontend (npm run dev) ; en production : https://<domaine-du-frontend>
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Base des liens envoyés par email (par défaut : la première origine ci-dessus)
# FRONTEND_URL=http://localhost:3000
# En production, si le frontend et l'API sont sur deux sous-domaines (ex: woolu.twoylit.tech et
# woolu-api.twoylit.tech), mettre le domaine parent pour que le frontend lise le cookie csrftoken
# CSRF_COOKIE_DOMAIN=.twoylit.tech

# PostgreSQL (laisser commenté pour utiliser SQLite en local)
# POSTGRES_DB=woolu
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Emails (mot de passe oublié). Sans EMAIL_HOST, ils s'affichent dans la console.
# Gmail : EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=587, mot de passe d'application
# (https://myaccount.google.com/apppasswords, nécessite la validation en deux étapes)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=Wóolu <adresse@domaine>

# Clés d'API

# Bitnob (https://app.bitnob.com → Paramètres → API / Webhooks)
BITNOB_CLIENT_ID=
BITNOB_CLIENT_SECRET=
BITNOB_WEBHOOK_SECRET=
# Taux XOF pour 1 USDC (mettre à jour depuis votre source de change validée)
BITNOB_XOF_PER_USDC=
# 1 = onglet « Payer » accessible sans connexion (ignoré avec une clé non sandbox)
BITNOB_PAIEMENTS_PUBLICS=0
